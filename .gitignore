# data is fetched, not vendored
data/TheVGLC/

# python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
dist/
build/

# secrets
.env

# eval outputs are committed deliberately (see eval/results); scratch is not
eval/scratch/
.DS_Store

# The verified-candidate cache IS committed. It is deterministic output of
# committed inputs, it is 1 MB, and without it a fresh clone spends 109s
# regenerating it before the tests can run -- which would make the "~40s"
# in docs/REPRODUCE.md false for the one person it matters to. Delete the
# directory to force regeneration if you change the solver or the edit
# vocabulary: nothing validates the cache against them.
