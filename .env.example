# Copy to .env and fill in. Never commit .env.
# Model access goes through litellm, so any provider it supports works --
# set the key that matches DUNGEON_REPAIR_MODEL below.

OPENAI_API_KEY=sk-...

# Default model. Anything litellm can route to is valid, for example:
#   openai/gpt-5.6-luna          (default)
#   openai/gpt-5.6
#   anthropic/claude-opus-5      (needs ANTHROPIC_API_KEY instead)
DUNGEON_REPAIR_MODEL=openai/gpt-5.6-luna

# Optional: point at a proxy or gateway instead of the provider's own endpoint.
# DUNGEON_REPAIR_API_BASE=https://...
